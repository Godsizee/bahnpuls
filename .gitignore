# Rohdaten liegen ausschliesslich auf dem Persistent Volume, nie im Repo (CLAUDE.md Regel 2)
/data/raw/*
/data/static/*
/data/ch/*
!/data/raw/.gitkeep
!/data/static/.gitkeep
!/data/ch/.gitkeep

# Go
/bin/
*.exe
*.test

# dbt (transform/) — DuckDB-Datei ist ein Build-Artefakt, kein Rohdatum, aber
# trotzdem nicht im Repo (waechst, ist aus data/ jederzeit neu baubar)
/data/*.duckdb
/transform/target/
/transform/dbt_packages/
/transform/logs/
/transform/.user.yml

# Evidence (dashboard/) -- Abhaengigkeiten und Build-Artefakte. dashboard/.gitignore
# deckt dasselbe ab; hier zusaetzlich, damit ein versehentliches Entfernen jener Datei
# nicht 900 npm-Pakete ins Repo zieht (CLAUDE.md Regel 14)
/dashboard/node_modules/
/dashboard/build/
/dashboard/.svelte-kit/
/dashboard/.evidence/template/
/dashboard/.evidence/meta/
/dashboard/static/data/

# Python (dbt-Tooling)
.venv/
__pycache__/

# Secrets — Repo muss jederzeit öffentlich auf GitHub einsehbar sein (CLAUDE.md Regel 14)
.env
.env.*
*.pem
*.key

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
